<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->
    <Color x:Key="PrimaryColor">#42A5F5</Color>
    <Color x:Key="PrimaryLightColor">#90CAF9</Color>
    <Color x:Key="PrimaryDarkColor">#1565C0</Color>
    <Color x:Key="AccentColor">#FFB74D</Color>
    <Color x:Key="SuccessColor">#66BB6A</Color>
    <Color x:Key="WarningColor">#FFD54F</Color>
    <Color x:Key="ErrorColor">#EF5350</Color>

    <Color x:Key="BackgroundColor">#121212</Color>
    <Color x:Key="SurfaceColor">#1E1E1E</Color>
    <Color x:Key="SurfaceVariantColor">#2D2D2D</Color>
    <Color x:Key="BorderColor">#424242</Color>
    <Color x:Key="BorderStrongColor">#616161</Color>

    <Color x:Key="TextPrimaryColor">#E0E0E0</Color>
    <Color x:Key="TextSecondaryColor">#9E9E9E</Color>
    <Color x:Key="TextDisabledColor">#616161</Color>
    <Color x:Key="TextOnPrimaryColor">#121212</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{DynamicResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{DynamicResource SurfaceVariantColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{DynamicResource TextOnPrimaryColor}" />

    <!-- AAFSS Specific Brushes (Dark) -->
    <SolidColorBrush x:Key="DamageGreenBrush" Color="#66BB6A" />
    <SolidColorBrush x:Key="DamageYellowBrush" Color="#FFD54F" />
    <SolidColorBrush x:Key="DamageRedBrush" Color="#EF5350" />
    <SolidColorBrush x:Key="StatusPendingBrush" Color="#757575" />
    <SolidColorBrush x:Key="StatusProcessingBrush" Color="#42A5F5" />
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="#66BB6A" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#EF5350" />

    <!-- ScrollBar Colors (Dark) -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#616161" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#757575" />

</ResourceDictionary>
