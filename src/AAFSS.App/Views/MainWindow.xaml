<Window x:Class="AAFSS.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AAFSS.App.ViewModels"
        xmlns:views="clr-namespace:AAFSS.App.Views"
        xmlns:conv="clr-namespace:AAFSS.App.Converters"
        xmlns:ctrl="clr-namespace:AAFSS.App.Controls"
        xmlns:avalon="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:avalonTheme="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:avalonLayout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:avalonControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:fluent="urn:fluent-ribbon"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1400" Height="900"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ribbon -->
        <fluent:Ribbon Grid.Row="0" IsMinimized="False">
            <fluent:Ribbon.Menu>
                <fluent:Backstage>
                    <fluent:BackstageTabControl>
                        <fluent:BackstageTabItem Header="新建" KeyTip="N" />
                        <fluent:BackstageTabItem Header="打开" KeyTip="O" />
                        <fluent:BackstageTabItem Header="保存" KeyTip="S" />
                        <fluent:BackstageTabItem Header="退出" KeyTip="X" />
                    </fluent:BackstageTabControl>
                </fluent:Backstage>
            </fluent:Ribbon.Menu>

            <!-- Start Tab -->
            <fluent:RibbonTabItem Header="开始">
                <fluent:RibbonGroupBox Header="项目">
                    <fluent:Button Header="新建" LargeIcon="pack://application:,,,/Resources/Images/new_project.png"
                                   Command="{Binding NewProjectCommand}" />
                    <fluent:Button Header="打开" Icon="pack://application:,,,/Resources/Images/open.png"
                                   Command="{Binding OpenProjectCommand}" />
                    <fluent:Button Header="保存" Icon="pack://application:,,,/Resources/Images/save.png"
                                   Command="{Binding SaveProjectCommand}" />
                </fluent:RibbonGroupBox>
                <fluent:RibbonGroupBox Header="数据">
                    <fluent:Button Header="导入数据" LargeIcon="pack://application:,,,/Resources/Images/import.png"
                                   Command="{Binding ImportDataCommand}" />
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- Analysis Tab -->
            <fluent:RibbonTabItem Header="分析">
                <fluent:RibbonGroupBox Header="信号">
                    <fluent:Button Header="信号预处理" Command="{Binding PreprocessSignalCommand}" />
                    <fluent:Button Header="雨流计数" Command="{Binding RainflowCountCommand}" />
                </fluent:RibbonGroupBox>
                <fluent:RibbonGroupBox Header="频谱">
                    <fluent:Button Header="频谱分析" Command="{Binding AnalyzeSpectrumCommand}" />
                    <fluent:Button Header="PSD估计" Command="{Binding ComputePsdCommand}" />
                </fluent:RibbonGroupBox>
                <fluent:RibbonGroupBox Header="载荷谱">
                    <fluent:Button Header="频谱编制" Command="{Binding CompileSpectrumCommand}" />
                    <fluent:Button Header="损伤计算" Command="{Binding CalculateDamageCommand}" />
                </fluent:RibbonGroupBox>
                <fluent:RibbonGroupBox Header="统计">
                    <fluent:Button Header="统计建模" Command="{Binding FitDistributionCommand}" />
                    <fluent:Button Header="验证" Command="{Binding ValidateSpectrumCommand}" />
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- Report Tab -->
            <fluent:RibbonTabItem Header="报告">
                <fluent:RibbonGroupBox Header="报告">
                    <fluent:Button Header="生成报告" Command="{Binding GenerateReportCommand}" />
                    <fluent:Button Header="导出数据" Command="{Binding ExportDataCommand}" />
                    <fluent:Button Header="打印" Command="{Binding PrintCommand}" />
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>
        </fluent:Ribbon>

        <!-- Main Content - AvalonDock -->
        <avalon:DockingManager Grid.Row="1" x:Name="DockManager"
                                DocumentsSource="{Binding OpenDocuments}"
                                ActiveContent="{Binding ActiveDocument, Mode=TwoWay}">

            <avalon:DockingManager.Theme>
                <avalonTheme:Vs2013LightTheme />
            </avalon:DockingManager.Theme>

            <avalonLayout:LayoutRoot>
            <avalonLayout:LayoutPanel Orientation="Vertical">
                <avalonLayout:LayoutPanel Orientation="Horizontal">
                    <!-- Left Panel: Project Explorer -->
                    <avalonLayout:LayoutAnchorablePane DockWidth="280" DockMinWidth="200">
                        <avalonLayout:LayoutAnchorable Title="项目资源管理器" ContentId="project-explorer"
                                                  CanClose="False" CanHide="False">
                            <avalonLayout:LayoutAnchorable.Content>
                                <ContentControl>
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Content" Value="{x:Null}" />
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </avalonLayout:LayoutAnchorable.Content>
                        </avalonLayout:LayoutAnchorable>
                    </avalonLayout:LayoutAnchorablePane>

                    <!-- Center: Document Area -->
                    <avalonLayout:LayoutDocumentPane />

                    <!-- Right Panel: Properties -->
                    <avalonLayout:LayoutAnchorablePane DockWidth="280" DockMinWidth="200">
                        <avalonLayout:LayoutAnchorable Title="属性" ContentId="property-panel"
                                                  CanClose="False" CanHide="False">
                        </avalonLayout:LayoutAnchorable>
                    </avalonLayout:LayoutAnchorablePane>
                </avalonLayout:LayoutPanel>

                <!-- Bottom Panel: Output -->
                    <avalonLayout:LayoutAnchorablePaneGroup DockHeight="150" Orientation="Horizontal">
                        <avalonLayout:LayoutAnchorablePane>
                            <avalonLayout:LayoutAnchorable Title="输出" ContentId="output-panel"
                                                      CanClose="False">
                            </avalonLayout:LayoutAnchorable>
                        </avalonLayout:LayoutAnchorablePane>
                    </avalonLayout:LayoutAnchorablePaneGroup>
            </avalonLayout:LayoutPanel>
            </avalonLayout:LayoutRoot>
        </avalon:DockingManager>

        <!-- Loading Overlay -->
        <ctrl:LoadingOverlay Grid.RowSpan="3"
                              IsLoading="{Binding IsBusy}"
                              Message="{Binding BusyMessage}"
                              IsIndeterminate="True"
                              Panel.ZIndex="1000" />

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{DynamicResource StatusBarBackgroundBrush}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding StatusText}" Margin="8,0" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <Separator />
            </StatusBarItem>
            <StatusBarItem Grid.Column="2">
                <TextBlock Text="{Binding StatusBar.MemoryUsageMB, StringFormat='{}{0:F1} MB'}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="3">
                <TextBlock Text="AAFSS v1.0" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
