<UserControl x:Class="AAFSS.App.Views.DataTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AAFSS.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Info Bar -->
        <Border Grid.Row="0" Padding="8,4" Background="{DynamicResource PanelHeaderBackgroundBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SourceLabel}" FontSize="12" Margin="0,0,16,0" />
                <TextBlock Text="{Binding TotalRows, StringFormat='行数: {0:N0}'}"
                           FontSize="11" Foreground="Gray" Margin="0,0,16,0" />
                <TextBlock Text="{Binding TotalColumns, StringFormat='列数: {0}'}"
                           FontSize="11" Foreground="Gray" />
            </StackPanel>
        </Border>

        <!-- Filter -->
        <Grid Grid.Row="1" Margin="4,4,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="筛选: " VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="12" Padding="4,2" />
        </Grid>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding DataView}"
                  AutoGenerateColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  HeadersVisibility="Column" />

        <!-- Status -->
        <Border Grid.Row="3" Padding="4,2" Background="{DynamicResource PanelHeaderBackgroundBrush}">
            <TextBlock Text="{Binding TotalRows, StringFormat='共 {0:N0} 行'}"
                       FontSize="11" Foreground="Gray" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</UserControl>
