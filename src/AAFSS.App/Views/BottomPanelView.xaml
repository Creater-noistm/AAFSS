<UserControl x:Class="AAFSS.App.Views.BottomPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AAFSS.App.ViewModels">

    <UserControl.Resources>
        <Style x:Key="OutputMessageStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate DataType="{x:Type vm:OutputMessage}">
            <Grid Margin="4,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                           FontSize="10" Foreground="Gray" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Width="60" FontSize="10" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter Property="Text" Value="[错误]" />
                                    <Setter Property="Foreground" Value="Red" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Text" Value="[警告]" />
                                    <Setter Property="Foreground" Value="Orange" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Info">
                                    <Setter Property="Text" Value="[信息]" />
                                    <Setter Property="Foreground" Value="Gray" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                    <Setter Property="Text" Value="[成功]" />
                                    <Setter Property="Foreground" Value="Green" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab Headers -->
        <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex}" Height="30">
            <TabItem Header="输出" />
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="错误" />
                        <TextBlock Text="{Binding ErrorCount, StringFormat=' ({0})'}"
                                   Foreground="Red" Margin="2,0,0,0"
                                   Visibility="{Binding ErrorCount, Converter={StaticResource CountToVisibility}}" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
        </TabControl>

        <!-- Content -->
        <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Messages}"
                     ItemContainerStyle="{StaticResource OutputMessageStyle}"
                     BorderThickness="0"
                     Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
            </ListBox>

            <ListBox ItemsSource="{Binding Errors}"
                     ItemContainerStyle="{StaticResource OutputMessageStyle}"
                     BorderThickness="0"
                     Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
            </ListBox>
        </Grid>

        <!-- Clear button -->
        <Button Grid.Row="0" Content="清除"
                HorizontalAlignment="Right" Margin="4"
                Command="{Binding ClearMessagesCommand}"
                Height="22" Width="50" FontSize="10" />
    </Grid>
</UserControl>
