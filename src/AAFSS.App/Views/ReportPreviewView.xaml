<UserControl x:Class="AAFSS.App.Views.ReportPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AAFSS.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="8,4" Background="{DynamicResource PanelHeaderBackgroundBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ReportTitle}" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,16,0" VerticalAlignment="Center" />
                <Button Content="生成报告" Command="{Binding GenerateReportCommand}"
                        Width="80" Height="24" FontSize="11" Margin="0,0,8,0" />
                <Button Content="导出" Command="{Binding ExportReportCommand}"
                        Width="60" Height="24" FontSize="11" Margin="0,0,8,0" />
                <TextBlock Text="模板:" VerticalAlignment="Center" FontSize="11" Margin="8,0,4,0" />
                <ComboBox ItemsSource="{Binding AvailableTemplates}"
                          SelectedItem="{Binding SelectedTemplate}"
                          Width="120" Height="24" FontSize="11" />
            </StackPanel>
        </Border>

        <!-- Report Content -->
        <Grid Grid.Row="1" Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}">
            <WebBrowser x:Name="ReportBrowser" />
        </Grid>

        <TextBlock Grid.Row="1" Text="请生成或选择一个报告查看"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="Gray" FontStyle="Italic" FontSize="14"
                   Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />

        <!-- Status -->
        <Border Grid.Row="2" Padding="8,4" Background="{DynamicResource PanelHeaderBackgroundBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="状态: " Foreground="Gray" FontSize="11" />
                <TextBlock Text="{Binding ReportStatus}" FontSize="11" Margin="0,0,16,0" />
                <TextBlock Text="路径: " Foreground="Gray" FontSize="11" />
                <TextBlock Text="{Binding ReportPath}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
