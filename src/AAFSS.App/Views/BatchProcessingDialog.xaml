<Window x:Class="AAFSS.App.Views.BatchProcessingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量处理" Width="720" Height="520"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择要执行的分析任务:" FontWeight="SemiBold" Margin="0,0,0,8" />

        <!-- Task Selection -->
        <GroupBox Grid.Row="1" Header="分析任务" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <CheckBox x:Name="ChkPreprocess" Content="信号预处理 (滤波、去趋势)" Margin="0,4" IsChecked="True" />
                    <CheckBox x:Name="ChkPsd" Content="PSD/Welch 功率谱分析" Margin="0,4" IsChecked="True" />
                    <CheckBox x:Name="ChkOctave" Content="倍频程分析 (1/3 OCT)" Margin="0,4" IsChecked="True" />
                    <CheckBox x:Name="ChkRainflow" Content="雨流循环计数" Margin="0,4" IsChecked="True" />
                    <CheckBox x:Name="ChkDistribution" Content="统计分布拟合" Margin="0,4" />
                    <CheckBox x:Name="ChkCompile" Content="编制载荷谱" Margin="0,4" IsChecked="True" />
                    <CheckBox x:Name="ChkDamage" Content="损伤计算与验证" Margin="0,4" IsChecked="True" />
                    <CheckBox x:Name="ChkReport" Content="生成报告" Margin="0,4" />
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- Progress -->
        <Grid Grid.Row="2" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="BatchProgress" Height="20"
                         Minimum="0" Maximum="100"
                         Visibility="Hidden" />
            <TextBlock Grid.Column="1" x:Name="ProgressText" Text=""
                       Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" />
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="开始批量处理" Width="100" Height="28"
                    Click="OnStartClick" Margin="0,0,8,0" />
            <Button Content="取消" Width="80" Height="28"
                    IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
