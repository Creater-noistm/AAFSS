<Window x:Class="AAFSS.App.Views.ImportDataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入数据" Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- File Selection -->
        <GroupBox Grid.Row="0" Header="文件选择" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilePathBox" Grid.Column="0" Margin="0,0,8,0"
                         VerticalAlignment="Center" IsReadOnly="True" />
                <Button Grid.Column="1" Content="浏览..." Width="80" Height="24"
                        Click="OnBrowseClick" />
            </Grid>
        </GroupBox>

        <!-- Format Options -->
        <GroupBox Grid.Row="1" Header="导入选项" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <CheckBox x:Name="HasHeaderCheck" Content="文件包含列标题" IsChecked="True" Margin="0,4" />
                    <CheckBox x:Name="AutoDetectCheck" Content="自动检测格式" IsChecked="True" Margin="0,4" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="所属任务剖面:" FontSize="11" />
                    <ComboBox x:Name="ProfileCombo" Height="24" Margin="0,4,0,0" />
                    <TextBlock Text="测量点:" FontSize="11" Margin="0,4,0,0" />
                    <ComboBox x:Name="PointCombo" Height="24" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Preview -->
        <TextBlock Grid.Row="2" Text="数据预览:" FontWeight="SemiBold" Margin="0,4" />
        <DataGrid Grid.Row="3" x:Name="PreviewGrid"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  MaxHeight="200"
                  GridLinesVisibility="Horizontal" />

        <!-- Progress -->
        <ProgressBar Grid.Row="4" x:Name="ImportProgress"
                     Height="20" Margin="0,8"
                     Minimum="0" Maximum="100"
                     IsIndeterminate="False"
                     Visibility="Hidden" />

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="导入" Width="80" Height="28"
                    Click="OnImportClick" Margin="0,0,8,0" />
            <Button Content="取消" Width="80" Height="28"
                    IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
