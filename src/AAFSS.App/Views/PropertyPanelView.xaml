<UserControl x:Class="AAFSS.App.Views.PropertyPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AAFSS.App.ViewModels"
             xmlns:conv="clr-namespace:AAFSS.App.Converters">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="8,6" Background="{DynamicResource PanelHeaderBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="{Binding EntityName}" FontWeight="SemiBold" FontSize="13"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding EntityType}" FontSize="11" Foreground="Gray" />
            </StackPanel>
        </Border>

        <!-- No selection placeholder -->
        <TextBlock Grid.Row="1" Text="未选择任何项目"
                   Foreground="Gray" FontStyle="Italic"
                   HorizontalAlignment="Center" Margin="0,20,0,0"
                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />

        <!-- Property Grid -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Properties}"
                 BorderThickness="0"
                 Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PropertyItem}">
                    <Grid Margin="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                   Foreground="Gray" FontSize="11"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding Description}" />
                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="12" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
