<UserControl x:Class="AAFSS.App.Views.PsdChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AAFSS.App.Converters"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8,4" Background="{DynamicResource PanelHeaderBackgroundBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ChartTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock Text="{Binding PeakFrequency, StringFormat='峰值频率: {0:F2} Hz'}"
                           FontSize="11" Foreground="Gray" Margin="0,0,16,0" />
                <TextBlock Text="{Binding RmsValue, StringFormat='RMS: {0:F3} g'}"
                           FontSize="11" Foreground="Gray" />
            </StackPanel>
        </Border>

        <sp:WpfPlot Grid.Row="1" x:Name="PsdPlot"
                    Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Grid.Row="1" Text="请选择一个频谱结果查看PSD"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="Gray" FontStyle="Italic" FontSize="14"
                   Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />

        <Border Grid.Row="2" Padding="8,4" Background="{DynamicResource PanelHeaderBackgroundBrush}">
            <TextBlock Text="{Binding WindowInfo}" FontSize="11" Foreground="Gray" />
        </Border>
    </Grid>
</UserControl>
