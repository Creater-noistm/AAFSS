<UserControl x:Class="AAFSS.App.Views.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AAFSS.App.ViewModels">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:CommandItem}">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="Gray" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="10"
                           Foreground="DimGray" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="#F0F0F0F0" CornerRadius="8"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
        <Grid Width="560" MaxHeight="400">
            <StackPanel Margin="12">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="8,6" BorderThickness="1"
                         BorderBrush="LightGray"
                         ToolTip="搜索命令 (Ctrl+Shift+P)" />

                <ListBox ItemsSource="{Binding Commands}"
                         SelectedItem="{Binding SelectedCommand}"
                         MaxHeight="320" Margin="0,8,0,0"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ExecuteCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding Close}" />
                        <KeyBinding Key="Up" Command="{Binding NavigateUp}" />
                        <KeyBinding Key="Down" Command="{Binding NavigateDown}" />
                    </ListBox.InputBindings>
                </ListBox>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
