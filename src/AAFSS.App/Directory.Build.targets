<Project>
  <PropertyGroup>
    <_IsWpfTempProject Condition="$([System.String]::new('$(MSBuildProjectName)').ToLowerInvariant().Contains('wpftmp'))">true</_IsWpfTempProject>
  </PropertyGroup>

  <!-- Strip ALL analyzers (source generators) from temp project BEFORE they're loaded -->
  <Target Name="StripTempAnalyzers" BeforeTargets="ResolveAssemblyReferences" Condition="'$(_IsWpfTempProject)' == 'true'">
    <Message Importance="high" Text="[AAFSS] Removing analyzers from temp project" />
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" />
    </ItemGroup>
  </Target>
</Project>
