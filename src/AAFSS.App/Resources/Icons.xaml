<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Icons.xaml - 应用图标资源字典
         使用 XAML Path 几何定义矢量图标（无需外部文件依赖）
    -->

    <!-- 项目图标 -->
    <Viewbox x:Key="IconProject" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource PrimaryBrush}" Data="M2,2 L6,2 L8,4 L14,4 L14,13 L2,13 Z" />
        </Canvas>
    </Viewbox>

    <!-- 文件夹图标 -->
    <Viewbox x:Key="IconFolder" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource WarningBrush}" Data="M2,3 L6,3 L7.5,4.5 L14,4.5 L14,13 L2,13 Z" />
        </Canvas>
    </Viewbox>

    <!-- 文件图标 -->
    <Viewbox x:Key="IconFile" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource TextSecondaryBrush}" Data="M4,1 L10,1 L14,5 L14,15 L4,15 Z M10,1 L10,5 L14,5" />
        </Canvas>
    </Viewbox>

    <!-- 保存图标 -->
    <Viewbox x:Key="IconSave" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource PrimaryBrush}" Data="M2,1 L10,1 L14,5 L14,15 L2,15 Z M4,15 L4,9 L12,9 L12,15 M4,1 L4,5 L10,5 L10,2" />
        </Canvas>
    </Viewbox>

    <!-- 刷新图标 -->
    <Viewbox x:Key="IconRefresh" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource PrimaryBrush}" Data="M8,2 L11,5 L8,8 M5,2 A6,6 0 1,0 13,8 L11,8 A4,4 0 1,1 5,4" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" />
        </Canvas>
    </Viewbox>

    <!-- 播放/运行图标 -->
    <Viewbox x:Key="IconPlay" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource SuccessBrush}" Data="M4,1 L14,8 L4,15 Z" />
        </Canvas>
    </Viewbox>

    <!-- 停止图标 -->
    <Viewbox x:Key="IconStop" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource ErrorBrush}" Data="M3,3 L13,3 L13,13 L3,13 Z" />
        </Canvas>
    </Viewbox>

    <!-- 搜索图标 -->
    <Viewbox x:Key="IconSearch" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource TextSecondaryBrush}" Data="M6.5,1 A5.5,5.5 0 1,0 6.5,12 A5.5,5.5 0 1,0 6.5,1 M11,11 L15,15" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2" />
        </Canvas>
    </Viewbox>

    <!-- 设置图标 -->
    <Viewbox x:Key="IconSettings" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource TextSecondaryBrush}" Data="M8,1 L9.5,4 L12.5,4.5 L14,7 L13,10 L14,13 L11,14.5 L8,13 L5,14.5 L2,13 L3,10 L2,7 L3.5,4.5 L6.5,4 Z M8,6 A2,2 0 1,0 8,10 A2,2 0 1,0 8,6" />
        </Canvas>
    </Viewbox>

    <!-- 频谱图标 -->
    <Viewbox x:Key="IconSpectrum" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource PrimaryBrush}" Data="M1,14 L3,14 L3,8 L1,8 Z M5,14 L7,14 L7,4 L5,4 Z M9,14 L11,14 L11,1 L9,1 Z M13,14 L15,14 L15,6 L13,6 Z" />
        </Canvas>
    </Viewbox>

    <!-- 波形图标 -->
    <Viewbox x:Key="IconWaveform" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="Transparent" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                  Data="M1,8 L3,8 L4,2 L6,14 L8,8 L10,8 L11,4 L13,12 L15,8" />
        </Canvas>
    </Viewbox>

    <!-- 警告图标 -->
    <Viewbox x:Key="IconWarning" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource WarningBrush}" Data="M8,1 L16,15 L0,15 Z M8,5 L8,10 M8,11.5 L8,13" Stroke="{DynamicResource TextOnPrimaryBrush}" StrokeThickness="1" />
        </Canvas>
    </Viewbox>

    <!-- 错误图标 -->
    <Viewbox x:Key="IconError" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource ErrorBrush}" Data="M8,1 A7,7 0 1,1 8,15 A7,7 0 1,1 8,1 M5,5 L11,11 M11,5 L5,11" Stroke="{DynamicResource TextOnPrimaryBrush}" StrokeThickness="2" />
        </Canvas>
    </Viewbox>

    <!-- 完成/对号图标 -->
    <Viewbox x:Key="IconSuccess" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource SuccessBrush}" Data="M8,1 A7,7 0 1,1 8,15 A7,7 0 1,1 8,1 M4.5,8 L7,10.5 L11.5,5" Stroke="{DynamicResource TextOnPrimaryBrush}" StrokeThickness="2" />
        </Canvas>
    </Viewbox>

    <!-- 信息图标 -->
    <Viewbox x:Key="IconInfo" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource PrimaryBrush}" Data="M8,1 A7,7 0 1,1 8,15 A7,7 0 1,1 8,1 M8,4 L8,5.5 M8,7 L8,12" Stroke="{DynamicResource TextOnPrimaryBrush}" StrokeThickness="1.5" />
        </Canvas>
    </Viewbox>

    <!-- 导入图标 -->
    <Viewbox x:Key="IconImport" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource PrimaryBrush}" Data="M8,1 L8,10 M4,7 L8,11 L12,7 M2,13 L14,13 L14,15 L2,15 Z" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" />
        </Canvas>
    </Viewbox>

    <!-- 导出图标 -->
    <Viewbox x:Key="IconExport" Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource PrimaryBrush}" Data="M8,15 L8,6 M4,9 L8,5 L12,9 M2,2 L14,2 L14,4 L2,4 Z" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" />
        </Canvas>
    </Viewbox>

</ResourceDictionary>
