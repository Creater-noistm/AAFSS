{
  "Application": {
    "Name": "AAFSS",
    "Version": "1.0.0",
    "Environment": "Development"
  },
  "Python": {
    "Home": "",
    "PythonPath": "python",
    "VirtualEnv": "",
    "UseEmbeddedPython": true,
    "EmbeddedPythonPath": ""
  },
  "Database": {
    "ConnectionString": "Data Source={AppData}/AAFSS/aafss.db",
    "AutoSaveIntervalMinutes": 5,
    "MaxRecentProjects": 10
  },
  "Hdf5": {
    "DefaultChunkSize": 1048576,
    "CompressionLevel": 4,
    "EnableSwmr": false
  },
  "Logging": {
    "MinimumLevel": "Information",
    "LogDirectory": "{AppData}/AAFSS/Logs",
    "RetainedFileCountLimit": 30,
    "FileSizeLimitBytes": 10485760
  },
  "UI": {
    "Theme": "Light",
    "Language": "zh-CN",
    "DefaultFontSize": 14.0,
    "DataTablePageSize": 1000,
    "VirtualScrollThreshold": 100000,
    "ChartAntiAliasing": true
  },
  "Plugins": {
    "PluginsDirectory": "Plugins",
    "EnablePluginSandbox": false,
    "AllowUnsignedPlugins": true
  },
  "Report": {
    "DefaultTemplate": "GJB_67_13_90",
    "TemplatesDirectory": "resources/templates",
    "OutputDirectory": "{Documents}/AAFSS/Reports"
  },
  "Validation": {
    "DamageTargetValue": 1.0,
    "DamageToleranceGreen": 0.05,
    "DamageToleranceYellow": 0.10,
    "MaxSpectrumPoints": 10000
  },
  "ExternalTools": {
    "PythonExecutable": "",
    "WordApplicationPath": ""
  }
}
